# PostgreSQL Connection String
# Leave blank to use the built-in persistent PostgreSQL 16 engine (./data/postgres),
# or point to an external PostgreSQL server (e.g. from docker-compose.yml).
DATABASE_URL=

# Optional: Default SimpleLogin API configuration (can also be configured via the UI)
SIMPLELOGIN_API_URL=https://app.simplelogin.io
SIMPLELOGIN_API_KEY=

# Server-side AES-256-GCM encryption secret for storing API keys at rest in PostgreSQL
ENCRYPTION_SECRET=bulk-alias-manager-default-32byte-key-2026
